<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Expert Laptop Repair Service | Quick & Affordable</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Chosen Palette: Calm Harmony -->
    <!-- Application Structure Plan: The SPA is structured as a conversion-focused landing page, following a logical AIDA (Attention, Interest, Desire, Action) flow. It starts with a strong Hero section to grab attention. The 'Common Issues' and 'Why Choose Us' sections build interest and desire by showcasing expertise and value propositions in a visually scannable format. The core of the page is an interactive 'Cost Estimator' which acts as a powerful engagement tool, giving the user a tangible reason to proceed. This structure was chosen to guide the user from their problem directly to the solution (calling for a quote), making the journey seamless and interactive, which is more effective than a static text page. -->
    <!-- Visualization & Content Choices: Report Info: Common laptop problems -> Goal: Build Interest -> Viz/Presentation: Interactive icon-based cards -> Interaction: Subtle hover effects for engagement -> Justification: More visually appealing and organized than a simple list. | Report Info: Value propositions (quick, reliable, etc.) -> Goal: Build Desire/Trust -> Viz/Presentation: Icon-based feature grid -> Interaction: None -> Justification: Easy to scan and digest key benefits. | Report Info: 'Free Quote' CTA -> Goal: Drive Action -> Viz/Presentation: Interactive form (dropdowns) -> Interaction: User selects options, JS calculates and displays an estimated cost range -> Justification: This provides immediate value to the user, answers a key question (price), and creates a strong incentive to call for an exact quote. It's the primary interactive element designed to convert. | Library/Method: All interactions are handled with vanilla JavaScript. -->
    <!-- CONFIRMATION: NO SVG graphics used. NO Mermaid JS used. -->
    <style>
        body {
            font-family: 'Lato', sans-serif;
        }
        @import url('https://fonts.googleapis.com/css2?family=Lato:wght@400;700;900&display=swap');
        .hero-bg {
            background-color: #f8f7f4;
        }
        .section-bg {
            background-color: #ffffff;
        }
        .card-bg {
            background-color: #f8f7f4;
        }
        .brand-text {
            color: #1e3a8a; /* A deep, trustworthy blue */
        }
        .accent-text {
            color: #3a5a40; /* A calm, reliable green */
        }
        .btn-primary {
            background-color: #87c739; /* Lime Green */
            color: white;
            transition: background-color 0.3s ease;
        }
        .btn-primary:hover {
            background-color: #6a9e2f; /* Darker Lime Green */
        }
        .btn-secondary {
            background-color: #98d64f; /* Lighter Lime Green */
            color: white;
            transition: background-color 0.3s ease;
        }
        .btn-secondary:hover {
            background-color: #87c739; /* Lime Green */
        }
    </style>
</head>
<body class="bg-gray-50 text-gray-800">

    <main class="w-full">
        <section id="hero" class="hero-bg py-20 md:py-32">
            <div class="container mx-auto px-6 text-center">
                <h1 class="text-4xl md:text-6xl font-extrabold brand-text leading-tight">Laptop Not Working?</h1>
                <p class="mt-4 text-lg md:text-xl text-gray-600 max-w-2xl mx-auto">Get it fixed fast with Chennai's trusted experts. Quick, reliable, and affordable service for all brands, right at your doorstep.</p>
                <div class="mt-8">
                    <a href="#estimator" class="btn-primary font-bold py-3 px-8 rounded-lg shadow-lg transform hover:scale-105 transition-transform duration-300">
                        Get a Free Estimate
                    </a>
                </div>
            </div>
        </section>

        <section id="issues" class="py-16 section-bg">
            <div class="container mx-auto px-6">
                <div class="text-center mb-12">
                    <h2 class="text-3xl md:text-4xl font-bold brand-text">Common Issues We Fix Instantly</h2>
                    <p class="mt-2 text-gray-600">From minor glitches to major repairs, we've got the expertise to handle it all.</p>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
                    <div class="card-bg p-6 rounded-lg shadow-md text-center transform transition-transform duration-300 hover:-translate-y-2">
                        <div class="text-5xl mb-4">💻</div>
                        <h3 class="text-xl font-bold text-gray-800">Slow Performance</h3>
                        <p class="text-gray-600 mt-2">Speed up your device with our optimization and upgrade services.</p>
                    </div>
                    <div class="card-bg p-6 rounded-lg shadow-md text-center transform transition-transform duration-300 hover:-translate-y-2">
                        <div class="text-5xl mb-4">🖥️</div>
                        <h3 class="text-xl font-bold text-gray-800">Broken Screen</h3>
                        <p class="text-gray-600 mt-2">Quick and reliable screen replacements for all laptop models.</p>
                    </div>
                    <div class="card-bg p-6 rounded-lg shadow-md text-center transform transition-transform duration-300 hover:-translate-y-2">
                        <div class="text-5xl mb-4">🌡️</div>
                        <h3 class="text-xl font-bold text-gray-800">Heating Issues</h3>
                        <p class="text-gray-600 mt-2">We solve overheating problems to protect your laptop's hardware.</p>
                    </div>
                    <div class="card-bg p-6 rounded-lg shadow-md text-center transform transition-transform duration-300 hover:-translate-y-2">
                        <div class="text-5xl mb-4">🔋</div>
                        <h3 class="text-xl font-bold text-gray-800">Power & Battery</h3>
                        <p class="text-gray-600 mt-2">From battery replacements to fixing 'not turning on' issues.</p>
                    </div>
                </div>
            </div>
        </section>

        <section id="why-us" class="py-16 hero-bg">
            <div class="container mx-auto px-6">
                <div class="text-center mb-12">
                    <h2 class="text-3xl md:text-4xl font-bold brand-text">Why Choose Our Service?</h2>
                    <p class="mt-2 text-gray-600">We are committed to providing top-quality service with transparency and care.</p>
                </div>
                <div class="grid md:grid-cols-3 gap-10 max-w-5xl mx-auto">
                    <div class="text-center">
                        <div class="text-4xl accent-text mb-3">✅</div>
                        <h3 class="text-xl font-bold mb-2">Certified Technicians</h3>
                        <p class="text-gray-600">Years of experience repairing all major brands and models.</p>
                    </div>
                    <div class="text-center">
                        <div class="text-4xl accent-text mb-3">⏱️</div>
                        <h3 class="text-xl font-bold mb-2">Same-Day Diagnosis</h3>
                        <p class="text-gray-600">We identify the problem quickly to get your repair started fast.</p>
                    </div>
                    <div class="text-center">
                        <div class="text-4xl accent-text mb-3">⚙️</div>
                        <h3 class="text-xl font-bold mb-2">Genuine Spare Parts</h3>
                        <p class="text-gray-600">We use only high-quality, authentic parts for lasting repairs.</p>
                    </div>
                     <div class="text-center">
                        <div class="text-4xl accent-text mb-3">🚚</div>
                        <h3 class="text-xl font-bold mb-2">Pickup & Delivery</h3>
                        <p class="text-gray-600">Convenient service at your doorstep. We pick up, repair, and deliver.</p>
                    </div>
                     <div class="text-center">
                        <div class="text-4xl accent-text mb-3">💯</div>
                        <h3 class="text-xl font-bold mb-2">100000+ Happy Customers</h3>
                        <p class="text-gray-600">Trusted by students, professionals, and businesses across Chennai.</p>
                    </div>
                     <div class="text-center">
                        <div class="text-4xl accent-text mb-3">💰</div>
                        <h3 class="text-xl font-bold mb-2">Affordable & Transparent</h3>
                        <p class="text-gray-600">No hidden costs. We provide a clear quote before starting any work.</p>
                    </div>
                </div>
            </div>
        </section>

        <section id="estimator" class="py-16 section-bg">
            <div class="container mx-auto px-6">
                <div class="text-center mb-12">
                    <h2 class="text-3xl md:text-4xl font-bold brand-text">Get a Quick Cost Estimate</h2>
                    <p class="mt-2 text-gray-600 max-w-2xl mx-auto">Select your device and issue to get an instant price range. This tool helps you get an idea of the cost before you call us for an exact quote.</p>
                </div>
                <div class="max-w-xl mx-auto card-bg p-8 rounded-lg shadow-lg">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
                        <div>
                            <label for="deviceType" class="block text-sm font-medium text-gray-700 mb-1">Device Type</label>
                            <select id="deviceType" class="w-full p-3 rounded-md border border-gray-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                                <option value="laptop">Standard Laptop</option>
                                <option value="macbook">MacBook</option>
                            </select>
                        </div>
                        <div>
                            <label for="issueType" class="block text-sm font-medium text-gray-700 mb-1">Issue Type</label>
                            <select id="issueType" class="w-full p-3 rounded-md border border-gray-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                                <option value="screen">Broken Screen</option>
                                <option value="battery">Battery Replacement</option>
                                <option value="keyboard">Keyboard Repair</option>
                                <option value="performance">Slow Performance / Tune-up</option>
                                <option value="power">Not Turning On</option>
                                <option value="other">Other Issue</option>
                            </select>
                        </div>
                    </div>
                    <button id="calculateBtn" class="w-full btn-secondary font-bold py-3 px-6 rounded-lg">Calculate Estimate</button>
                    <div id="result" class="mt-6 text-center bg-white p-6 rounded-md" style="display: none;">
                        <p class="text-lg font-medium text-gray-800">Estimated Cost:</p>
                        <p id="priceRange" class="text-3xl font-bold brand-text my-2"></p>
                        <p id="disclaimer" class="text-sm text-gray-500"></p>
                    </div>
                </div>
            </div>
        </section>

        <section id="cta" class="py-20 hero-bg">
            <div class="container mx-auto px-6 text-center">
                <h2 class="text-3xl md:text-4xl font-bold brand-text">Ready to Get Your Laptop Fixed?</h2>
                <p class="mt-4 text-lg text-gray-600">Don't let laptop issues slow you down. Call our experts now for instant support!</p>
                <div class="mt-8">
                    <a href="tel:988474542" class="inline-block btn-primary text-2xl font-bold py-4 px-10 rounded-lg shadow-lg transform hover:scale-105 transition-transform duration-300">
                        📞 Call Now: 9884745432
                    </a>
                </div>
            </div>
        </section>
    </main>

    <footer class="bg-gray-800 text-white py-6">
        <div class="container mx-auto px-6 text-center text-sm">
            <p>&copy; 2025 Laptop Repair Service Chennai. All Rights Reserved.</p>
            <p class="mt-1">Your trusted local experts in laptop and computer repairs.</p>
        </div>
    </footer>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const calculateBtn = document.getElementById('calculateBtn');
            const resultDiv = document.getElementById('result');
            const priceRangeEl = document.getElementById('priceRange');
            const disclaimerEl = document.getElementById('disclaimer');

            const priceEstimates = {
                laptop: {
                    screen: '₹3,500 - ₹7,000',
                    battery: '₹2,500 - ₹4,500',
                    keyboard: '₹1,500 - ₹3,000',
                    performance: '₹1,000 - ₹2,500',
                    power: '₹1,200 - ₹5,000',
                    other: 'Diagnosis required',
                },
                macbook: {
                    screen: '₹12,000 - ₹40,000',
                    battery: '₹6,000 - ₹15,000',
                    keyboard: '₹5,000 - ₹12,000',
                    performance: '₹2,500 - ₹5,000',
                    power: '₹3,000 - ₹10,000',
                    other: 'Diagnosis required',
                }
            };

            calculateBtn.addEventListener('click', () => {
                const deviceType = document.getElementById('deviceType').value;
                const issueType = document.getElementById('issueType').value;

                const estimate = priceEstimates[deviceType][issueType];

                if (issueType === 'other') {
                    priceRangeEl.textContent = 'Contact Us for Quote';
                    disclaimerEl.textContent = 'For complex issues, we need to diagnose the device first. Please call for accurate pricing.';
                } else {
                    priceRangeEl.textContent = estimate;
                    disclaimerEl.textContent = 'This is an estimated range. The final price depends on the specific model and extent of damage. Call us for a precise quote.';
                }
                
                resultDiv.style.display = 'block';
            });

            document.querySelectorAll('a[href^="#"]').forEach(anchor => {
                anchor.addEventListener('click', function (e) {
                    e.preventDefault();
                    document.querySelector(this.getAttribute('href')).scrollIntoView({
                        behavior: 'smooth'
                    });
                });
            });
        });
    </script>

</body>
</html>

